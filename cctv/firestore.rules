rules_version = '2';

// Deploy against the named "cassava" database, e.g.:
//   firebase deploy --only firestore:rules --database=cassava
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Public catalogue data — readable by anyone, writable only by admins.
    match /products/{productId} {
      allow read: if resource.data.visibility == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /collections/{collectionId} {
      allow read: if resource.data.visibility != 'hidden' || isAdmin();
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{videoId} {
      // "private" videos are metadata only here — actual private media
      // should be served through signed Storage URLs / a Cloud Function,
      // never a public Firestore field.
      allow read: if resource.data.visibility == 'public' || isAdmin();
      allow write: if isAdmin();
    }
    match /homepage/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Access requests — anyone can submit one, nobody but an admin can
    // read, list, update, or delete them. This is intentional: a visitor
    // should never be able to see other visitors' requests or their own
    // request's status by guessing a document ID.
    match /access_requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name','email','timestamp']);
      allow read, update, delete: if isAdmin();
    }

    // Newsletter — public create only.
    match /newsletter/{subId} {
      allow create: if request.resource.data.keys().hasAll(['email']);
      allow read, update, delete: if isAdmin();
    }

    // Customers — a signed-in customer can read/write only their own doc.
    match /customers/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Everything else (orders, coupons, admins, analytics, media) is
    // admin-only until those modules are built out.
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }
    match /coupons/{couponId} {
      allow read: if isAdmin(); // validated server-side via Cloud Function at checkout, not read directly by shoppers
      allow write: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }
    match /media/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
